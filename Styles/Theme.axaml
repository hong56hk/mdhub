<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- App palette. Every UI color lives here; controls use {DynamicResource Key} so switching theme applies live.
       Code-built visuals use ThemeService.Brush(key), which reads these same entries. Dark is the original look. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppBackground" Color="#17191D" />
      <SolidColorBrush x:Key="TabStripBackground" Color="#1B1E23" />
