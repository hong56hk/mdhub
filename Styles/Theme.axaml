<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- App palette. Every UI color lives here; controls use {DynamicResource Key} so switching theme applies live.
       Code-built visuals use ThemeService.Brush(key), which reads these same entries. Dark is the original look. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppBackground" Color="#17191D" />
      <SolidColorBrush x:Key="TabStripBackground" Color="#1B1E23" />
      <SolidColorBrush x:Key="EditorBackground" Color="#202329" />
      <SolidColorBrush x:Key="PreviewBackground" Color="#101318" />
      <SolidColorBrush x:Key="ToolbarBackground" Color="#20242A" />
      <SolidColorBrush x:Key="FloatingBackground" Color="#252A32" />
      <SolidColorBrush x:Key="InputBackground" Color="#1B1E23" />
      <SolidColorBrush x:Key="ButtonBackground" Color="#2B313A" />
      <SolidColorBrush x:Key="HoverBackground" Color="#303843" />
      <SolidColorBrush x:Key="PressedBackground" Color="#3A4657" />
      <SolidColorBrush x:Key="DropTargetBackground" Color="#394553" />
      <SolidColorBrush x:Key="BorderSubtle" Color="#30343B" />
      <SolidColorBrush x:Key="PanelBorder" Color="#3A4252" />
      <SolidColorBrush x:Key="SeparatorForeground" Color="#D3D3D3" />
      <SolidColorBrush x:Key="TextPrimary" Color="#D7DCE5" />
      <SolidColorBrush x:Key="TextStrong" Color="#DCE3EE" />
      <SolidColorBrush x:Key="TextSecondary" Color="#B2BCCB" />
      <SolidColorBrush x:Key="FolderNameForeground" Color="#BEC6D3" />
      <SolidColorBrush x:Key="TextMuted" Color="#8893A3" />
      <SolidColorBrush x:Key="SidebarTabForeground" Color="#8993A4" />
      <SolidColorBrush x:Key="SectionForeground" Color="#969FAE" />
      <SolidColorBrush x:Key="DialogHintForeground" Color="#A9B1BC" />
      <SolidColorBrush x:Key="ShortcutKeyForeground" Color="#9AA4B2" />
      <SolidColorBrush x:Key="PreviewPlaceholderForeground" Color="#788393" />
      <SolidColorBrush x:Key="AcceleratorForeground" Color="#7D8796" />
      <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#7D8796" />
      <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#7D8796" />
      <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="#7D8796" />
      <SolidColorBrush x:Key="IconForeground" Color="#AAB8CC" />
      <SolidColorBrush x:Key="Accent" Color="#8DADE8" />
      <SolidColorBrush x:Key="AccentStrong" Color="#82AAFF" />
      <SolidColorBrush x:Key="AccentSoft" Color="#3D8DADE8" />
      <SolidColorBrush x:Key="Danger" Color="#C42B1C" />
      <SolidColorBrush x:Key="CaptionCloseHoverBackground" Color="#C42B1C" />
      <SolidColorBrush x:Key="ErrorForeground" Color="#E8A08D" />
      <SolidColorBrush x:Key="DialogErrorForeground" Color="#F29D9D" />
      <SolidColorBrush x:Key="RenameErrorBorder" Color="#CD5C5C" />
      <SolidColorBrush x:Key="CurrentLineBackground" Color="#20D3D3D3" />
      <SolidColorBrush x:Key="FindMatchBackground" Color="#4DD9A441" />
      <SolidColorBrush x:Key="FindCurrentBackground" Color="#99E8A33D" />
      <SolidColorBrush x:Key="FindCurrentBorder" Color="#F0B45A" />
      <SolidColorBrush x:Key="GutterForeground" Color="#6B7280" />
      <SolidColorBrush x:Key="SyntaxHeading" Color="#C792EA" />
      <SolidColorBrush x:Key="SyntaxOrderedList" Color="#82AAFF" />
      <SolidColorBrush x:Key="SyntaxUnorderedList" Color="#8FD6A0" />
      <SolidColorBrush x:Key="PreviewHighlight" Color="#5C4F8FE8" />
      <SolidColorBrush x:Key="PreviewSelectionBackground" Color="#99306FB8" />
        <!-- Explorer rows, VS Code Dark Modern: focused selection, selection while focus is elsewhere, hover. -->
        <SolidColorBrush x:Key="ExplorerSelectionBackground" Color="#04395E" />
        <SolidColorBrush x:Key="ExplorerSelectionBorder" Color="#0078D4" />
        <SolidColorBrush x:Key="ExplorerSelectionInactiveBackground" Color="#37373D" />
        <SolidColorBrush x:Key="ExplorerHoverBackground" Color="#2A2D2E" />
      <SolidColorBrush x:Key="SearchLineNumberForeground" Color="#8993A4" />
      <SolidColorBrush x:Key="SearchMatchForeground" Color="#FFD580" />
      <SolidColorBrush x:Key="SearchMatchBackground" Color="#55452A" />
      <SolidColorBrush x:Key="CodeBlockBackground" Color="#1B2028" />
      <SolidColorBrush x:Key="QuoteBorder" Color="#7295D4" />
      <SolidColorBrush x:Key="TableBorder" Color="#363D48" />
      <SolidColorBrush x:Key="TableHeaderBackground" Color="#242B36" />
      <SolidColorBrush x:Key="RuleForeground" Color="#363D48" />
      <SolidColorBrush x:Key="InlineCodeBackground" Color="#29313C" />
      <SolidColorBrush x:Key="InlineCodeForeground" Color="#B8CFF4" />
      <SolidColorBrush x:Key="LinkForeground" Color="#8DADE8" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppBackground" Color="#F3F3F3" />
      <SolidColorBrush x:Key="TabStripBackground" Color="#E8E8E8" />
      <SolidColorBrush x:Key="EditorBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PreviewBackground" Color="#FAFAFA" />
      <SolidColorBrush x:Key="ToolbarBackground" Color="#F5F5F5" />
      <SolidColorBrush x:Key="FloatingBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ButtonBackground" Color="#E4E7EB" />
      <SolidColorBrush x:Key="HoverBackground" Color="#E1E4E8" />
      <SolidColorBrush x:Key="PressedBackground" Color="#D0D5DC" />
      <SolidColorBrush x:Key="DropTargetBackground" Color="#CFE0F7" />
      <SolidColorBrush x:Key="BorderSubtle" Color="#D6D9DE" />
      <SolidColorBrush x:Key="PanelBorder" Color="#C3C9D1" />
      <SolidColorBrush x:Key="SeparatorForeground" Color="#C8CDD3" />
      <SolidColorBrush x:Key="TextPrimary" Color="#1F2328" />
      <SolidColorBrush x:Key="TextStrong" Color="#0F1419" />
      <SolidColorBrush x:Key="TextSecondary" Color="#3E4652" />
      <SolidColorBrush x:Key="FolderNameForeground" Color="#2E3440" />
      <SolidColorBrush x:Key="TextMuted" Color="#5F6875" />
      <SolidColorBrush x:Key="SidebarTabForeground" Color="#5F6875" />
      <SolidColorBrush x:Key="SectionForeground" Color="#5F6875" />
      <SolidColorBrush x:Key="DialogHintForeground" Color="#4E5663" />
      <SolidColorBrush x:Key="ShortcutKeyForeground" Color="#4E5663" />
      <SolidColorBrush x:Key="PreviewPlaceholderForeground" Color="#6A7380" />
      <SolidColorBrush x:Key="AcceleratorForeground" Color="#6A7380" />
      <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#6A7380" />
      <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#6A7380" />
      <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="#6A7380" />
      <SolidColorBrush x:Key="IconForeground" Color="#4A5566" />
      <SolidColorBrush x:Key="Accent" Color="#2563C9" />
      <SolidColorBrush x:Key="AccentStrong" Color="#2563C9" />
      <SolidColorBrush x:Key="AccentSoft" Color="#332563C9" />
      <SolidColorBrush x:Key="Danger" Color="#C42B1C" />
      <SolidColorBrush x:Key="CaptionCloseHoverBackground" Color="#C42B1C" />
      <SolidColorBrush x:Key="ErrorForeground" Color="#B3412A" />
      <SolidColorBrush x:Key="DialogErrorForeground" Color="#B3261E" />
      <SolidColorBrush x:Key="RenameErrorBorder" Color="#C0392B" />
      <SolidColorBrush x:Key="CurrentLineBackground" Color="#12000000" />
      <SolidColorBrush x:Key="FindMatchBackground" Color="#66F2C94C" />
      <SolidColorBrush x:Key="FindCurrentBackground" Color="#99F0A02A" />
      <SolidColorBrush x:Key="FindCurrentBorder" Color="#B87400" />
      <SolidColorBrush x:Key="GutterForeground" Color="#8A929E" />
      <SolidColorBrush x:Key="SyntaxHeading" Color="#8E3FB5" />
      <SolidColorBrush x:Key="SyntaxOrderedList" Color="#2563C9" />
      <SolidColorBrush x:Key="SyntaxUnorderedList" Color="#23804A" />
      <SolidColorBrush x:Key="PreviewHighlight" Color="#404F8FE8" />
      <SolidColorBrush x:Key="PreviewSelectionBackground" Color="#99ADD6FF" />
        <!-- Explorer rows, VS Code Light Modern: focused selection, selection while focus is elsewhere, hover. -->
        <SolidColorBrush x:Key="ExplorerSelectionBackground" Color="#CCE8FF" />
        <SolidColorBrush x:Key="ExplorerSelectionBorder" Color="#0078D4" />
        <SolidColorBrush x:Key="ExplorerSelectionInactiveBackground" Color="#E4E6F1" />
        <SolidColorBrush x:Key="ExplorerHoverBackground" Color="#E8E8E8" />
      <SolidColorBrush x:Key="SearchLineNumberForeground" Color="#5F6875" />
      <SolidColorBrush x:Key="SearchMatchForeground" Color="#6B4100" />
      <SolidColorBrush x:Key="SearchMatchBackground" Color="#FFE3A3" />
      <SolidColorBrush x:Key="CodeBlockBackground" Color="#F2F4F7" />
      <SolidColorBrush x:Key="QuoteBorder" Color="#7295D4" />
      <SolidColorBrush x:Key="TableBorder" Color="#D0D7DE" />
      <SolidColorBrush x:Key="TableHeaderBackground" Color="#EEF1F4" />
      <SolidColorBrush x:Key="RuleForeground" Color="#D0D7DE" />
      <SolidColorBrush x:Key="InlineCodeBackground" Color="#EBEEF2" />
      <SolidColorBrush x:Key="InlineCodeForeground" Color="#1F4A8A" />
      <SolidColorBrush x:Key="LinkForeground" Color="#2563C9" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>