<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\mdhub.ico</ApplicationIcon>
    <!-- Item 58: About shows the informational version exactly; no "+commit" SourceLink suffix. -->
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0 (alpha)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Markdig" Version="1.5.0" />
    <Compile Remove="tests/**/*.cs" />
    <AvaloniaResource Include="Assets\mdhub-128.png" />
    <EmbeddedResource Include="LICENSE" LogicalName="Mdhub.LICENSE" />
    <PackageReference Include="UTF.Unknown" Version="2.6.0" />
  </ItemGroup>
</Project>
