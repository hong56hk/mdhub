<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mdhub.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Mdhub/Styles/Theme.axaml" />
        <ResourceInclude Source="avares://Mdhub/Styles/FileIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Mdhub/Styles/WorkspaceStyles.axaml" />
    <StyleInclude Source="avares://Mdhub/Styles/MarkdownEditor.axaml" />
    <StyleInclude Source="avares://Mdhub/Styles/FindStyles.axaml" />
  </Application.Styles>
</Application>
