<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Mdhub.Components"
             x:Class="Mdhub.Views.MainView">
  <UserControl.Styles>
    <Style Selector="Button.sidebarTab">
      <Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource SidebarTabForeground}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" /><Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.sidebarTab.active">
      <Setter Property="Foreground" Value="{DynamicResource TextStrong}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentStrong}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <components:TopMenu x:Name="TopMenu" />
    <components:TextFormatter x:Name="TextFormatter" Grid.Row="1" />
    <Grid x:Name="Workspace" Grid.Row="2" Grid.RowSpan="2" ColumnDefinitions="240,4,*,4,*,0,0">
      <Grid x:Name="Sidebar" RowDefinitions="Auto,*" Background="{DynamicResource AppBackground}">
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,6,4,4">
          <Button x:Name="ExplorerTab" Content="{DynamicResource SidebarExplorer}" Classes="sidebarTab active" Click="ExplorerTab_Click" ToolTip.Tip="{DynamicResource SidebarExplorerTip}" />
          <Button x:Name="SearchTab" Content="{DynamicResource SidebarSearch}" Classes="sidebarTab" Click="SearchTab_Click" ToolTip.Tip="{DynamicResource SidebarSearchTip}" />
        </StackPanel>
        <components:FolderExplorer x:Name="FolderExplorer" Grid.Row="1" />
        <components:GlobalSearch x:Name="GlobalSearch" Grid.Row="1" IsVisible="False" />
      </Grid>
      <GridSplitter x:Name="FolderSplitter" Grid.Column="1" Background="{DynamicResource BorderSubtle}" ResizeDirection="Columns" />
      <Grid x:Name="PaneHost" Grid.Column="2" Grid.ColumnSpan="3">
        <components:EditorPane x:Name="PrimaryPane" />
      </Grid>
      <GridSplitter x:Name="OutlineSplitter" Grid.Column="5" IsVisible="False" Background="{DynamicResource BorderSubtle}" ResizeDirection="Columns" />
      <components:DocumentOutline x:Name="Outline" Grid.Column="6" IsVisible="False" />
      <components:QuickOpen x:Name="QuickOpenBox" Grid.Column="2" Grid.ColumnSpan="3" ZIndex="20" />
    </Grid>
    <components:BottomStatusBar x:Name="BottomStatusBar" Grid.Row="4" />
  </Grid>
</UserControl>
