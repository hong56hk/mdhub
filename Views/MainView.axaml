<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Mdhub.Components"
             x:Class="Mdhub.Views.MainView">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <components:TopMenu x:Name="TopMenu" />
    <components:FileTabs x:Name="FileTabs" Grid.Row="1" />
    <components:TextFormatter x:Name="TextFormatter" Grid.Row="2" />
    <Grid x:Name="Workspace" Grid.Row="3" ColumnDefinitions="240,4,*,4,*">
      <components:FolderExplorer x:Name="FolderExplorer" />
      <GridSplitter x:Name="FolderSplitter" Grid.Column="1" Background="#30343B" ResizeDirection="Columns" />
      <components:TextEditor x:Name="TextEditor" Grid.Column="2" />
      <GridSplitter x:Name="PreviewSplitter" Grid.Column="3" Background="#30343B" ResizeDirection="Columns" />
      <components:MdEditor x:Name="MdEditor" Grid.Column="4" />
    </Grid>
    <components:BottomStatusBar x:Name="BottomStatusBar" Grid.Row="4" />
  </Grid>
</UserControl>
