<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Mdhub.Views"
        x:Class="Mdhub.MainWindow" Title="mdhub"
        Width="1340" Height="820" MinWidth="800" MinHeight="480" Background="#17191D"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32" CanResize="True">
  <views:MainView x:Name="MainView" />
</Window>
