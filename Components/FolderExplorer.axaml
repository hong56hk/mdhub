<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Mdhub.Components.FolderExplorer">
  <UserControl.Resources>
    <!-- VS Code-like indent per level; the chevron slot stays reserved for files so same-level names align. -->
    <x:Double x:Key="TreeViewItemIndent">10</x:Double>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Files keep an empty chevron-sized slot so their names start at the same x as folders on that level. -->
    <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
      <Setter Property="MinWidth" Value="12" />
    </Style>
    <Style Selector="TreeViewItem.dropTarget">
      <Setter Property="Background" Value="{DynamicResource DropTargetBackground}" />
    </Style>
    <Style Selector="Button.explorerAction">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource IconForeground}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.explorerAction:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>
    <Style Selector="Button.explorerAction:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PressedBackground}" />
    </Style>
    <Style Selector="Button.folderName">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.folderName:pointerover /template/ ContentPresenter, Button.folderName:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.folderName:pointerover TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Button.folderName.dropTarget /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DropTargetBackground}" />
    </Style>
    <Style Selector="Path.explorerIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeThickness" Value="1.25" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="FolderPanel" RowDefinitions="Auto,*" Background="{DynamicResource AppBackground}">
    <Grid ColumnDefinitions="*,Auto" Margin="14,4,6,8">
      <Button x:Name="FolderNameButton" Classes="folderName" Click="FolderName_Click" Cursor="Hand" ToolTip.Tip="Open a folder (Ctrl+Shift+O)" AutomationProperties.Name="Open folder">
        <TextBlock x:Name="FolderName" Text="Open Folder" Foreground="{DynamicResource FolderNameForeground}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </Button>
      <StackPanel x:Name="FolderActions" Grid.Column="1" Orientation="Horizontal" Spacing="2" IsEnabled="False">
        <Button x:Name="NewFileButton" Classes="explorerAction" Click="NewFile_Click" ToolTip.Tip="New file" AutomationProperties.Name="New file">
          <Path Classes="explorerIcon" Data="M 6.5,14 L 2.5,14 2.5,2 8.5,2 12,5.5 12,7 M 8.5,2 L 8.5,5.5 12,5.5 M 11.5,9 L 11.5,15 M 8.5,12 L 14.5,12"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
        <Button x:Name="NewFolderButton" Classes="explorerAction" Click="NewFolder_Click" ToolTip.Tip="New folder" AutomationProperties.Name="New folder">
          <Path Classes="explorerIcon" Data="M 6.5,13.5 L 1.5,13.5 1.5,3 6,3 8,5 14,5 14,7 M 1.5,6.5 L 7,6.5 M 11.5,9 L 11.5,15 M 8.5,12 L 14.5,12"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
        <Button x:Name="ReloadFolderButton" Classes="explorerAction" Click="RefreshFolder_Click" ToolTip.Tip="Reload" AutomationProperties.Name="Reload folder">
          <Path Classes="explorerIcon" Data="M 13,6 A 5.5,5.5 0 1 0 13,10 M 13,2.5 L 13,6 9.5,6"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
        <Button x:Name="CollapseAllButton" Classes="explorerAction" Click="CollapseAll_Click" ToolTip.Tip="Collapse all" AutomationProperties.Name="Collapse all folders">
          <Path Classes="explorerIcon" Data="M 5,2 L 14,2 14,11 M 2,5 L 11,5 11,14 2,14 Z M 4.5,9.5 L 8.5,9.5"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
      </StackPanel>
    </Grid>
    <TreeView x:Name="FolderTree" Grid.Row="1" Background="Transparent" SelectionChanged="FolderTree_SelectionChanged" />
  </Grid>
</UserControl>
