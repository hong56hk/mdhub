<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Mdhub.Components.EmojiPicker" Width="400">
  <UserControl.Styles>
    <Style Selector="Button.emojiCell">
      <Setter Property="Height" Value="40" /><Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="2" /><Setter Property="FontSize" Value="24" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.emojiCell:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>
    <Style Selector="ToggleButton.emojiCategory">
      <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="CornerRadius" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.emojiCategory:checked">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStrong}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="10" Background="{DynamicResource FloatingBackground}">
    <TextBox x:Name="EmojiSearchBox" PlaceholderText="{DynamicResource EmojiSearch}" AutomationProperties.Name="{DynamicResource EmojiSearch}" />
    <StackPanel x:Name="EmojiCategories" Orientation="Horizontal" Spacing="2" />
    <TextBlock x:Name="EmojiCategoryHeading" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
    <Grid MinHeight="160">
      <ScrollViewer x:Name="EmojiScroll" MaxHeight="280" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
        <UniformGrid x:Name="EmojiGrid" Columns="9" />
      </ScrollViewer>
      <TextBlock x:Name="EmojiNoResults" Text="{DynamicResource EmojiNoResults}" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
    </Grid>
  </StackPanel>
</UserControl>
