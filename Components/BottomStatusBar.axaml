<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Mdhub.Components.BottomStatusBar">
  <UserControl.Styles>
    <!-- Item 40: the file path copies on click; hand cursor and a subtle underline on hover. -->
    <Style Selector="TextBlock#StatusAction:pointerover">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="TextBlock#Status.pathLink">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBlock#Status.pathLink:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>
  <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="12,7">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
      <TextBlock x:Name="Counts" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
      <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
        <TextBlock x:Name="Status" Margin="20,0" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Background="Transparent" PointerReleased="Status_PointerReleased" />
        <!-- Item 51: an action for the current message (e.g. Open after an export). -->
        <TextBlock x:Name="StatusAction" Grid.Column="1" Margin="0,0,20,0" FontSize="11" Foreground="{DynamicResource LinkForeground}" Cursor="Hand" IsVisible="False" Background="Transparent" PointerReleased="StatusAction_PointerReleased" />
      </Grid>
      <TextBlock x:Name="CaretLabel" Grid.Column="2" Margin="0,0,16,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" IsVisible="False" />
      <!-- Item 66: INS/OVR; a click toggles insert/overwrite. -->
      <TextBlock x:Name="ModeLabel" Grid.Column="3" Margin="0,0,16,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" Cursor="Hand" Background="Transparent" IsVisible="False" PointerReleased="ModeLabel_Toggle" />
      <TextBlock x:Name="FileKindLabel" Grid.Column="4" Margin="0,0,16,0" FontSize="11" Foreground="{DynamicResource TextMuted}" Text="Markdown" />
      <!-- Item 67: a click opens Reopen / Save with Encoding. -->
      <TextBlock x:Name="EncodingLabel" Grid.Column="5" FontSize="11" Foreground="{DynamicResource Accent}" Text="UTF-8" Cursor="Hand" Background="Transparent" PointerReleased="EncodingLabel_PointerReleased" />
    </Grid>
  </Border>
</UserControl>
