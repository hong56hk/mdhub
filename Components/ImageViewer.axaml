<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Mdhub.Components.ImageViewer">
  <Border Background="{DynamicResource EditorBackground}" Padding="20">
    <!-- Item 37: the picture is placed by hand so Ctrl+wheel can zoom around the pointer. -->
    <Canvas x:Name="Surface" Background="Transparent" ClipToBounds="True">
      <Image x:Name="Picture" Stretch="Fill" AutomationProperties.Name="{DynamicResource ImagePreview}" />
    </Canvas>
  </Border>
</UserControl>
