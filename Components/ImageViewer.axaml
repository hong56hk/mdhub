<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Mdhub.Components.ImageViewer"
             Focusable="True" FocusAdorner="{x:Null}">
  <UserControl.Styles>
    <!-- Item 91: thin-stroke icon buttons in theme colours; the selected tool is highlighted like the view-mode toggle. -->
    <Style Selector="Button.imageTool">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource PreviewToggleOff}" />
    </Style>
    <Style Selector="Button.imageTool.on">
      <Setter Property="Foreground" Value="{DynamicResource AccentStrong}" />
      <Setter Property="Background" Value="{DynamicResource PreviewToggleOnBackground}" />
    </Style>
    <Style Selector="Button.imageTool:disabled Path">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.imageTool Path">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    </Style>
  </UserControl.Styles>
  <UserControl.ContextMenu>
    <ContextMenu x:Name="ViewerMenu">
      <!-- Item 99: same as the toolbar buttons / Ctrl+= and Ctrl+-; gesture text comes from the shortcut table. -->
      <MenuItem x:Name="MenuZoomIn" />
      <MenuItem x:Name="MenuZoomOut" />
      <Separator />
      <MenuItem x:Name="MenuRotateLeft" Header="{DynamicResource ImageRotateLeft}" />
      <MenuItem x:Name="MenuRotateRight" Header="{DynamicResource ImageRotateRight}" />
      <MenuItem x:Name="MenuFlipHorizontal" Header="{DynamicResource ImageFlipHorizontal}" />
      <MenuItem x:Name="MenuFlipVertical" Header="{DynamicResource ImageFlipVertical}" />
      <Separator />
      <MenuItem x:Name="MenuFit" Header="{DynamicResource ImageFitWindow}" />
      <MenuItem x:Name="MenuActualSize" Header="{DynamicResource ImageActualSize}" />
      <MenuItem x:Name="MenuResetView" Header="{DynamicResource ImageResetView}" />
    </ContextMenu>
  </UserControl.ContextMenu>
  <Grid>
    <Border Background="{DynamicResource EditorBackground}" Padding="20">
      <!-- Item 37: the picture is placed by hand so Ctrl+wheel can zoom around the pointer. Item 91: rotate/flip are a render transform. -->
      <Canvas x:Name="Surface" Background="Transparent" ClipToBounds="True">
        <Image x:Name="Picture" Stretch="Fill" RenderTransformOrigin="50%,50%" AutomationProperties.Name="{DynamicResource ImagePreview}" />
      </Canvas>
    </Border>
    <Border x:Name="Toolbar" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" Padding="2" CornerRadius="7"
            Background="{DynamicResource ToolbarBackground}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
            AutomationProperties.Name="{DynamicResource ImageToolbar}">
      <StackPanel Orientation="Horizontal" Spacing="1">
        <Button x:Name="HandButton" Classes="imageTool" ToolTip.Tip="{DynamicResource ImageHandTool}" AutomationProperties.Name="{DynamicResource ImageHandTool}">
          <Path Data="M5.5 8.5V4a1 1 0 0 1 2 0v3.5 M7.5 7V2.8a1 1 0 0 1 2 0V7 M9.5 7V3.8a1 1 0 0 1 2 0V8 M11.5 8V5.8a1 1 0 0 1 2 0V10c0 2.8-2 4.8-4.6 4.8C6.6 14.8 5.4 13.9 4.4 12.3L2.6 9.4a1 1 0 0 1 1.6-1.2l1.3 1.5" />
        </Button>
        <!-- Items 96/98: one zoom step around the view centre (Ctrl+= / Ctrl+-); tooltips set in code with the live shortcut. -->
        <Button x:Name="ZoomInButton" Classes="imageTool" AutomationProperties.Name="{DynamicResource ImageZoomIn}">
          <Path Data="M7 2.5a4.5 4.5 0 1 0 0.01 0 M10.3 10.3L14 14 M5 7h4 M7 5v4" />
        </Button>
        <Button x:Name="ZoomOutButton" Classes="imageTool" AutomationProperties.Name="{DynamicResource ImageZoomOut}">
          <Path Data="M7 2.5a4.5 4.5 0 1 0 0.01 0 M10.3 10.3L14 14 M5 7h4" />
        </Button>
        <Button x:Name="RotateToolButton" Classes="imageTool" ToolTip.Tip="{DynamicResource ImageRotateTool}" AutomationProperties.Name="{DynamicResource ImageRotateTool}">
          <Path Data="M13.5 8a5.5 5.5 0 1 1-1.6-3.9 M12.2 1.6v2.6H9.6 M8 6.5v3 M6.5 8h3" />
        </Button>
        <Border Width="1" Margin="3,4" Background="{DynamicResource BorderSubtle}" />
        <Button x:Name="RotateLeftButton" Classes="imageTool" ToolTip.Tip="{DynamicResource ImageRotateLeft}" AutomationProperties.Name="{DynamicResource ImageRotateLeft}">
          <Path Data="M3.2 6.5a5 5 0 1 1 1.2 5 M3 2.5v4h4" />
        </Button>
        <Button x:Name="RotateRightButton" Classes="imageTool" ToolTip.Tip="{DynamicResource ImageRotateRight}" AutomationProperties.Name="{DynamicResource ImageRotateRight}">
          <Path Data="M12.8 6.5a5 5 0 1 0-1.2 5 M13 2.5v4H9" />
        </Button>
        <Button x:Name="FlipHorizontalButton" Classes="imageTool" ToolTip.Tip="{DynamicResource ImageFlipHorizontal}" AutomationProperties.Name="{DynamicResource ImageFlipHorizontal}">
          <Path Data="M8 1.5v13 M6 4.5L2 12h4z M10 4.5l4 7.5h-4z" />
        </Button>
        <Button x:Name="FlipVerticalButton" Classes="imageTool" ToolTip.Tip="{DynamicResource ImageFlipVertical}" AutomationProperties.Name="{DynamicResource ImageFlipVertical}">
          <Path Data="M1.5 8h13 M4.5 6L12 2v4z M4.5 10l7.5 4v-4z" />
        </Button>
        <Border Width="1" Margin="3,4" Background="{DynamicResource BorderSubtle}" />
        <Button x:Name="FitButton" Classes="imageTool" ToolTip.Tip="{DynamicResource ImageFitWindow}" AutomationProperties.Name="{DynamicResource ImageFitWindow}">
          <Path Data="M2 6V2h4 M10 2h4v4 M14 10v4h-4 M6 14H2v-4" />
        </Button>
        <Button x:Name="ActualSizeButton" Classes="imageTool" ToolTip.Tip="{DynamicResource ImageActualSize}" AutomationProperties.Name="{DynamicResource ImageActualSize}">
          <Path Data="M3 5l1.5-1v8 M8 6.5v0.1 M8 9.5v0.1 M11 5l1.5-1v8" />
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
