<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Mdhub.Components" x:Class="Mdhub.Components.TextFormatter">
  <!-- Item 48: the toggle-preview button is a split-editor icon; its colour (and a subtle background) shows the state. -->
  <UserControl.Styles>
    <Style Selector="Button#TogglePreviewButton">
      <Setter Property="Foreground" Value="{DynamicResource PreviewToggleOff}" />
      <Setter Property="Padding" Value="7,5" />
    </Style>
    <Style Selector="Button#TogglePreviewButton.on">
      <Setter Property="Foreground" Value="{DynamicResource PreviewToggleOn}" />
      <Setter Property="Background" Value="{DynamicResource PreviewToggleOnBackground}" />
    </Style>
  </UserControl.Styles>
  <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1" Padding="8,5" Background="{DynamicResource ToolbarBackground}">
    <Grid ColumnDefinitions="*,Auto">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="FormatBar" Orientation="Horizontal" Spacing="2">
          <Button Content="↶" Tag="undo" Classes="tool" Click="Edit_Click" ToolTip.Tip="{DynamicResource Undo}" />
          <Button Content="↷" Tag="redo" Classes="tool" Click="Edit_Click" ToolTip.Tip="{DynamicResource Redo}" />
          <Button Content="B" Tag="bold" Classes="tool" Click="Format_Click" ToolTip.Tip="{DynamicResource Bold}" />
          <Button Content="I" Tag="italic" Classes="tool" Click="Format_Click" ToolTip.Tip="{DynamicResource Italic}" />
          <Button Tag="strike" Classes="tool" Click="Format_Click" ToolTip.Tip="{DynamicResource Strikethrough}"><c:StrikeGlyph /></Button>
          <Button Content="&lt;/&gt;" Tag="code" Classes="tool" Click="Format_Click" ToolTip.Tip="{DynamicResource InlineCode}" />
          <Button Content="H1" Tag="h1" Classes="tool" Click="Format_Click" ToolTip.Tip="{DynamicResource Heading1}" />
          <Button Content="H2" Tag="h2" Classes="tool" Click="Format_Click" ToolTip.Tip="{DynamicResource Heading2}" />
          <Button Content="H3" Tag="h3" Classes="tool" Click="Format_Click" ToolTip.Tip="{DynamicResource Heading3}" />
          <Button Content="{DynamicResource ListButton}" Tag="list" Classes="tool" Click="Format_Click" ToolTip.Tip="{DynamicResource BulletList}" />
          <Button Content="{DynamicResource NumberedButton}" Tag="ordered" Classes="tool" Click="Format_Click" ToolTip.Tip="{DynamicResource NumberedList}" />
          <Button Content="❝" Tag="quote" Classes="tool" Click="Format_Click" ToolTip.Tip="{DynamicResource BlockQuote}" />
          <Button Content="{DynamicResource LinkButton}" Tag="link" Classes="tool" Click="Format_Click" ToolTip.Tip="{DynamicResource InsertLink}" />
          <Button Content="{DynamicResource TableButton}" Tag="table" Classes="tool" Click="Format_Click" ToolTip.Tip="{DynamicResource InsertTable}" />
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
        <!-- Room is left to the right of this button for the item 35 settings (gear) button. -->
        <Button x:Name="TogglePreviewButton" Classes="tool" Click="TogglePreview_Click" AutomationProperties.Name="{DynamicResource TogglePreview}">
          <Path x:Name="TogglePreviewIcon" Width="16" Height="14" Stretch="None" StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Data="M 3,1.5 H 13 A 1.5,1.5 0 0 1 14.5,3 V 11 A 1.5,1.5 0 0 1 13,12.5 H 3 A 1.5,1.5 0 0 1 1.5,11 V 3 A 1.5,1.5 0 0 1 3,1.5 Z M 8,1.5 V 12.5" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
