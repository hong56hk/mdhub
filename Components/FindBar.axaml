<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Mdhub.Components.FindBar"
             HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="False">

  <Border Background="{DynamicResource FloatingBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="0,0,6,6" Padding="4,4,6,4" BoxShadow="0 2 8 0 #66000000">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
      <ToggleButton x:Name="ExpandReplaceToggle" Classes="findAction" Grid.RowSpan="2" VerticalAlignment="Stretch" Height="NaN" Width="18" MinWidth="18" Padding="1"
                    ToolTip.Tip="{DynamicResource ToggleReplaceTip}" AutomationProperties.Name="{DynamicResource ToggleReplace}">
        <Path x:Name="ExpandIcon" Classes="findIcon" Data="M 6,4 L 10,8 6,12" Stroke="{DynamicResource IconForeground}" />
      </ToggleButton>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="3,0,0,0">
        <TextBox x:Name="FindInput" Classes="findField" Watermark="{DynamicResource Find}" AutomationProperties.Name="{DynamicResource Find}">
          <TextBox.InnerRightContent>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
              <ToggleButton x:Name="MatchCaseToggle" Classes="fieldToggle" Content="Aa" ToolTip.Tip="{DynamicResource MatchCase}" AutomationProperties.Name="{DynamicResource MatchCase}" />
              <ToggleButton x:Name="WholeWordToggle" Classes="fieldToggle" ToolTip.Tip="{DynamicResource WholeWord}" AutomationProperties.Name="{DynamicResource WholeWord}">
                <TextBlock Text="ab" TextDecorations="Underline" />
              </ToggleButton>
              <ToggleButton x:Name="RegexToggle" Classes="fieldToggle" Content=".*" ToolTip.Tip="{DynamicResource UseRegex}" AutomationProperties.Name="{DynamicResource UseRegex}" />
            </StackPanel>
          </TextBox.InnerRightContent>
        </TextBox>
        <TextBlock x:Name="FindCount" MinWidth="74" Margin="6,0,4,0" FontSize="12" Foreground="{DynamicResource IconForeground}" VerticalAlignment="Center" />
        <Button x:Name="FindPreviousButton" Classes="findAction" ToolTip.Tip="{DynamicResource PreviousMatchTip}" AutomationProperties.Name="{DynamicResource PreviousMatch}">
          <Path Classes="findIcon" Data="M 8,13 L 8,3 M 4,7 L 8,3 12,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
        <Button x:Name="FindNextButton" Classes="findAction" ToolTip.Tip="{DynamicResource NextMatchTip}" AutomationProperties.Name="{DynamicResource NextMatch}">
          <Path Classes="findIcon" Data="M 8,3 L 8,13 M 4,9 L 8,13 12,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
        <ToggleButton x:Name="FindInSelectionToggle" Classes="findAction accent" ToolTip.Tip="{DynamicResource FindInSelection}" AutomationProperties.Name="{DynamicResource FindInSelection}">
          <Path Classes="findIcon" Data="M 2.5,4 L 13.5,4 M 2.5,8 L 13.5,8 M 2.5,12 L 9,12" Stroke="{DynamicResource IconForeground}" />
        </ToggleButton>
        <Button x:Name="FindCloseButton" Classes="findAction" ToolTip.Tip="{DynamicResource FindCloseTip}" AutomationProperties.Name="{DynamicResource FindClose}">
          <Path Classes="findIcon" Data="M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
      </StackPanel>
      <StackPanel x:Name="ReplaceRow" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="3,4,0,0" IsVisible="False">
        <TextBox x:Name="ReplaceInput" Classes="findField" Watermark="{DynamicResource Replace}" AutomationProperties.Name="{DynamicResource Replace}">
          <TextBox.InnerRightContent>
            <ToggleButton x:Name="PreserveCaseToggle" Classes="fieldToggle" Content="AB" Margin="0,0,3,0" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource PreserveCase}" AutomationProperties.Name="{DynamicResource PreserveCase}" />
          </TextBox.InnerRightContent>
        </TextBox>
        <Button x:Name="ReplaceButton" Classes="textAction" Content="{DynamicResource Replace}" ToolTip.Tip="{DynamicResource ReplaceTip}" />
        <Button x:Name="ReplaceAllButton" Classes="textAction" Content="{DynamicResource ReplaceAll}" ToolTip.Tip="{DynamicResource ReplaceAllTip}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
