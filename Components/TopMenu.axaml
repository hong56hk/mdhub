<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Mdhub.Components" x:Class="Mdhub.Components.TopMenu">
  <UserControl.Styles>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CaptionCloseHoverBackground}" />
    </Style>
    <!-- Dropdown items: 8px more room before the text, and a muted right-aligned shortcut. -->
    <Style Selector="MenuItem MenuItem">
      <Setter Property="Padding" Value="19,9,11,10" />
    </Style>
    <Style Selector="TextBlock.recentPath">
      <Setter Property="Foreground" Value="{DynamicResource AcceleratorForeground}" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
      <Setter Property="Foreground" Value="{DynamicResource AcceleratorForeground}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="Auto,*,Auto" Height="32" Background="{DynamicResource AppBackground}">
  <Menu x:Name="MainMenu" Background="{DynamicResource AppBackground}" VerticalAlignment="Center">
    <MenuItem Header="{DynamicResource MenuFile}">
      <MenuItem Header="{DynamicResource MenuNew}" Click="New_Click" c:ShortcutKeys.Id="file.new" />
      <MenuItem Header="{DynamicResource MenuOpenFile}" Click="Open_Click" c:ShortcutKeys.Id="file.open" />
      <MenuItem Header="{DynamicResource MenuOpenFolder}" Click="OpenFolder_Click" c:ShortcutKeys.Id="file.openFolder" />
      <!-- Filled from RecentService: files, folders, then Clear Recently Opened. -->
      <MenuItem x:Name="OpenRecentMenu" Header="{DynamicResource MenuOpenRecent}" />
      <MenuItem Header="{DynamicResource MenuQuickOpen}" Click="Command_Click" c:ShortcutKeys.Id="file.quickOpen" />
      <MenuItem Header="{DynamicResource MenuSave}" Click="Save_Click" c:ShortcutKeys.Id="file.save" />
      <MenuItem Header="{DynamicResource MenuSaveAs}" Click="SaveAs_Click" c:ShortcutKeys.Id="file.saveAs" />
      <MenuItem x:Name="ExportMenu" Header="{DynamicResource MenuExport}">
        <MenuItem x:Name="ExportHtmlMenuItem" Header="{DynamicResource MenuExportHtml}" Click="ExportHtml_Click" />
        <MenuItem x:Name="ExportPdfMenuItem" Header="{DynamicResource MenuExportPdf}" Click="ExportPdf_Click" />
      </MenuItem>
      <MenuItem Header="{DynamicResource MenuCloseTab}" Click="CloseTab_Click" c:ShortcutKeys.Id="file.closeTab" />
      <MenuItem Header="{DynamicResource MenuExit}" Click="Exit_Click" />
    </MenuItem>
    <MenuItem Header="{DynamicResource MenuEdit}">
      <MenuItem Header="{DynamicResource MenuUndo}" Click="Edit_Click" Tag="undo" c:ShortcutKeys.Id="edit.undo" />
      <MenuItem Header="{DynamicResource MenuRedo}" Click="Edit_Click" Tag="redo" c:ShortcutKeys.Id="edit.redo" />
      <MenuItem Header="{DynamicResource MenuCut}" Click="Edit_Click" Tag="cut" c:ShortcutKeys.Id="edit.cut" />
      <MenuItem Header="{DynamicResource MenuCopy}" Click="Edit_Click" Tag="copy" c:ShortcutKeys.Id="edit.copy" />
      <MenuItem Header="{DynamicResource MenuPaste}" Click="Edit_Click" Tag="paste" c:ShortcutKeys.Id="edit.paste" />
      <MenuItem Header="{DynamicResource MenuSelectAll}" Click="Edit_Click" Tag="select all" c:ShortcutKeys.Id="edit.selectAll" />
      <Separator />
      <MenuItem Header="{DynamicResource MenuBold}" Click="Command_Click" c:ShortcutKeys.Id="editor.bold" />
      <MenuItem Header="{DynamicResource MenuItalic}" Click="Command_Click" c:ShortcutKeys.Id="editor.italic" />
      <MenuItem Header="{DynamicResource MenuInsertLink}" Click="Command_Click" c:ShortcutKeys.Id="editor.link" />
      <MenuItem Header="{DynamicResource MenuBlockQuote}" Click="Command_Click" c:ShortcutKeys.Id="editor.quote" />
      <MenuItem Header="{DynamicResource MenuInsertDateTime}" Click="Command_Click" c:ShortcutKeys.Id="editor.insertTime" />
      <Separator />
      <MenuItem Header="{DynamicResource MenuGoToLine}" Click="Command_Click" c:ShortcutKeys.Id="editor.goToLine" />
    </MenuItem>
    <MenuItem Header="{DynamicResource MenuView}">
      <MenuItem Header="{DynamicResource MenuToggleFolders}" Click="ToggleFolders_Click" />
      <MenuItem Header="{DynamicResource MenuTogglePreview}" Click="TogglePreview_Click" c:ShortcutKeys.Id="view.togglePreview" />
      <MenuItem Header="{DynamicResource MenuToggleWordWrap}" Click="WordWrap_Click" c:ShortcutKeys.Id="view.wordWrap" />
      <MenuItem Header="{DynamicResource MenuNextTab}" Click="Command_Click" c:ShortcutKeys.Id="view.nextTab" />
      <MenuItem Header="{DynamicResource MenuPreviousTab}" Click="Command_Click" c:ShortcutKeys.Id="view.previousTab" />
      <MenuItem Header="{DynamicResource MenuScrollPreview}" Click="Command_Click" c:ShortcutKeys.Id="view.previewCaret" />
      <MenuItem x:Name="RevealInSidebarMenuItem" Header="{DynamicResource RevealInSidebar}" Click="Command_Click" c:ShortcutKeys.Id="file.revealInSidebar" />
      <MenuItem Header="{DynamicResource MenuRefreshFolder}" Click="RefreshFolder_Click" />
    </MenuItem>
    <MenuItem Header="{DynamicResource MenuSettings}">
      <MenuItem Header="{DynamicResource MenuShortcut}" Click="Shortcuts_Click" />
      <MenuItem x:Name="ThemeMenu" Header="{DynamicResource MenuTheme}">
        <MenuItem x:Name="ThemeDarkMenuItem" Header="{DynamicResource ThemeDark}" ToggleType="Radio" GroupName="theme" Click="Theme_Click" Tag="Dark" />
        <MenuItem x:Name="ThemeLightMenuItem" Header="{DynamicResource ThemeLight}" ToggleType="Radio" GroupName="theme" Click="Theme_Click" Tag="Light" />
      </MenuItem>
      <MenuItem x:Name="LanguageMenu" Header="{DynamicResource MenuLanguage}" />
    </MenuItem>
    <MenuItem Header="{DynamicResource MenuHelp}">
      <MenuItem Header="{DynamicResource MenuGuide}" Click="Guide_Click" />
      <MenuItem Header="{DynamicResource MenuAbout}" Click="About_Click" />
    </MenuItem>
  </Menu>
  <Border x:Name="TitleBarDragRegion" Grid.Column="1" Background="Transparent"
          WindowDecorationProperties.ElementRole="TitleBar" />
  <StackPanel Grid.Column="2" Orientation="Horizontal">
    <Button x:Name="MinimizeButton" Classes="caption" Click="Minimize_Click"
            ToolTip.Tip="{DynamicResource Minimize}" AutomationProperties.Name="{DynamicResource Minimize}">
      <Path Data="M 0,5 L 10,5" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
    </Button>
    <Button x:Name="MaximizeButton" Classes="caption" Click="Maximize_Click"
            ToolTip.Tip="{DynamicResource Maximize}" AutomationProperties.Name="{DynamicResource Maximize}">
      <Path x:Name="MaximizeIcon" Data="M 0.5,0.5 L 9.5,0.5 9.5,9.5 0.5,9.5 Z" Width="10" Height="10"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
    </Button>
    <Button x:Name="CloseWindowButton" Classes="caption close" Click="CloseWindow_Click"
            ToolTip.Tip="{DynamicResource Close}" AutomationProperties.Name="{DynamicResource CloseWindow}">
      <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
    </Button>
  </StackPanel>
  </Grid>
</UserControl>
