<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mdhub.Components.PdfViewer"
             Focusable="True"
             Background="{DynamicResource EditorBackground}">
  <Grid RowDefinitions="Auto,*">
    <!-- Item 102c: the right-hand slot is reserved for the Notes button. -->
    <Border x:Name="Toolbar" Height="36"
            Background="{DynamicResource ToolbarBackground}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
            AutomationProperties.Name="{DynamicResource PdfToolbar}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="ZoomLabel" VerticalAlignment="Center" Margin="12,0" FontSize="12"
                   Foreground="{DynamicResource EditorForeground}" />
        <Border Grid.Column="1" MinWidth="88" Margin="8,0" />
      </Grid>
    </Border>
    <ScrollViewer x:Name="Scroller" Grid.Row="1"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource EditorBackground}">
      <StackPanel x:Name="Pages" Margin="16" HorizontalAlignment="Center" />
    </ScrollViewer>
    <TextBlock x:Name="ErrorText" Grid.Row="1" IsVisible="False" TextWrapping="Wrap" Margin="40"
               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
               Foreground="{DynamicResource EditorForeground}" FontSize="14" />
  </Grid>
</UserControl>