<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="using:Mdhub.Components" x:Class="Mdhub.Components.TextEditor">
  <Grid Background="{DynamicResource EditorTextBackground}" MinWidth="180">
    <Grid ColumnDefinitions="Auto,*">
      <components:LineNumberGutter x:Name="LineGutter" Cursor="Arrow" />
      <components:MarkdownBlockOverlay x:Name="MarkdownBlocks" Grid.Column="1" />
      <components:CurrentLineOverlay x:Name="CurrentLine" Grid.Column="1" />
      <ContentControl x:Name="EditorHost" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <components:FindHighlightOverlay x:Name="FindHighlights" Grid.Column="1" />
    </Grid>
    <components:FindBar x:Name="FindBar" Margin="0,0,18,0" />
    <!-- Item 57: editor fonts (same gear as the preview's); hidden while the find bar occupies the corner. -->
    <Button x:Name="EditorFontsButton" Classes="tool" Padding="7,5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,16,0"
            IsVisible="{Binding !#FindBar.IsVisible}"
            Background="{DynamicResource EditorBackground}" ToolTip.Tip="{DynamicResource EditorFontSettings}" AutomationProperties.Name="{DynamicResource EditorFontSettings}">
      <Path x:Name="EditorFontsIcon" Width="16" Height="16" Stretch="None" StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
            Data="M 13,8 A 5,5 0 1 1 3,8 A 5,5 0 1 1 13,8 Z M 10,8 A 2,2 0 1 1 6,8 A 2,2 0 1 1 10,8 Z M 8,1 V 3 M 8,13 V 15 M 1,8 H 3 M 13,8 H 15 M 3.05,3.05 L 4.46,4.46 M 12.95,12.95 L 11.54,11.54 M 12.95,3.05 L 11.54,4.46 M 3.05,12.95 L 4.46,11.54" />
    </Button>
  </Grid>
</UserControl>