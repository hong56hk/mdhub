<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Mdhub.Components" x:Class="Mdhub.Components.MdEditor">
  <Grid x:Name="PreviewPanel" Background="{DynamicResource PreviewBackground}" MinWidth="180">
    <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Disabled">
      <Panel x:Name="PreviewLayer">
        <c:PreviewBlockHighlight x:Name="PreviewBlockHighlights" IsHitTestVisible="False" />
        <c:PreviewSelectionOverlay x:Name="PreviewSelectionLayer" IsHitTestVisible="False" />
        <StackPanel x:Name="PreviewContent" Margin="24" Spacing="14" />
      </Panel>
    </ScrollViewer>
    <!-- Item 35: preview typography. A thin-stroke gear at the top-right opens a flyout (Components/PreviewSettingsFlyout.cs). -->
    <Button x:Name="PreviewSettingsButton" Classes="tool" Padding="7,5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,16,0"
            Background="{DynamicResource PreviewBackground}" ToolTip.Tip="{DynamicResource PreviewSettings}" AutomationProperties.Name="{DynamicResource PreviewSettings}">
      <Path x:Name="PreviewSettingsIcon" Width="16" Height="16" Stretch="None" StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
            Data="M 13,8 A 5,5 0 1 1 3,8 A 5,5 0 1 1 13,8 Z M 10,8 A 2,2 0 1 1 6,8 A 2,2 0 1 1 10,8 Z M 8,1 V 3 M 8,13 V 15 M 1,8 H 3 M 13,8 H 15 M 3.05,3.05 L 4.46,4.46 M 12.95,12.95 L 11.54,11.54 M 12.95,3.05 L 11.54,4.46 M 3.05,12.95 L 4.46,11.54" />
    </Button>
  </Grid>
</UserControl>